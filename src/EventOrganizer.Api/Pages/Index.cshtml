@page
@model EventOrganizer.Api.Pages.IndexModel
@{
    ViewData["Title"] = "Події";
    var userText = HttpContext.Session.GetString("UserText") ?? "";
}

<section class="hero-section">
    <div class="page-title-box">
        <h1>Організація спільних подій та витрат</h1>
        <p class="hero-subtitle">Плануйте поїздки, контролюйте спільний бюджет і прозоро розподіляйте витрати між друзями</p>
    </div>
</section>

@if (TempData["DashboardOk"] is string dashMsg && !string.IsNullOrEmpty(dashMsg))
{
    <div class="notice ok" style="margin-bottom: 18px;">@dashMsg</div>
}

<div class="card">
    <div class="section-header">
        <div>
            <h2>Список подій</h2>
            <p class="subtitle" style="margin-bottom: 0;">Шукайте за назвою або фільтруйте за станом події</p>
        </div>
    </div>

    <form method="get" class="filter-bar">
        <div class="field filter-grow">
            <label for="search">Пошук за назвою</label>
            <input id="search" type="text" name="search" value="@Model.Search" placeholder="Наприклад: Карпати..." />
        </div>

        <div class="field">
            <label for="status">Статус події</label>
            <select id="status" name="status">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Усі статуси</option>
                <option value="Created" selected="@(Model.Status == "Created")">Активні (Створена)</option>
                <option value="Closed" selected="@(Model.Status == "Closed")">Закриті</option>
                <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Скасовані</option>
            </select>
        </div>

        <label class="chip-checkbox filter-check">
            <input type="checkbox" name="onlyMine" value="true" checked="@Model.OnlyMine" />
            <span>Тільки мої</span>
        </label>

        <div class="filter-buttons">
            <button type="submit" class="btn-primary">Знайти</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status) || Model.OnlyMine)
            {
                <a asp-page="/Index" class="btn-outline-soft">Скинути</a>
            }
        </div>
    </form>

    @if (Model.Events.Length == 0)
    {
        <div class="empty-state">
            Подій за заданими критеріями не знайдено. Спробуйте змінити фільтр або створіть нову подію нижче.
        </div>
    }
    else
    {
        <div class="events-grid">
            @foreach (var ev in Model.Events)
            {
                var statusLabel = ev.Status == "Created"
                    ? "Активна"
                    : (ev.Status == "Closed" ? "Закрита" : "Скасована");
                var statusBadgeClass = ev.Status == "Created"
                    ? "badge"
                    : (ev.Status == "Closed" ? "badge closed" : "badge cancelled");

                var hasBudget = ev.BudgetLimit is > 0;
                var pct = hasBudget ? Math.Min(100m, ev.TotalSpent * 100m / ev.BudgetLimit!.Value) : 0m;
                var barClass = hasBudget && ev.TotalSpent >= ev.BudgetLimit!.Value * 0.80m
                    ? "budget-bar-fill warn"
                    : "budget-bar-fill";

                <article class="event-card">
                    <div class="event-card-top">
                        <span class="@statusBadgeClass">@statusLabel</span>
                        <span class="invite-tag">Код: <b>@ev.InviteCode</b></span>
                    </div>

                    <h3 class="event-card-title">@ev.Title</h3>
                    <div class="event-card-meta">
                        <span>@ev.Date.ToString("dd.MM.yyyy")</span>
                        @if (!string.IsNullOrWhiteSpace(ev.Place))
                        {
                            <span>• @ev.Place</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ev.Description))
                    {
                        <p class="event-card-desc">@ev.Description</p>
                    }

                    <div class="event-card-budget">
                        @if (hasBudget)
                        {
                            <div class="budget-mini-row">
                                <span>Витрачено: <b>@ev.TotalSpent.ToString("F2")</b> / @ev.BudgetLimit!.Value.ToString("F2") грн</span>
                                <span>@((ev.TotalSpent * 100m / ev.BudgetLimit!.Value).ToString("F0"))%</span>
                            </div>
                            <div class="budget-bar-track small">
                                <div class="@barClass" style="width: @pct.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                            </div>
                        }
                        else
                        {
                            <div class="budget-mini-row muted">
                                <span>Витрачено: <b>@ev.TotalSpent.ToString("F2") грн</b></span>
                                <span>Без ліміту</span>
                            </div>
                        }
                    </div>

                    <div class="event-card-footer">
                        <span class="participants-count">Учасників: <b>@ev.Participants.Length</b></span>
                        <a asp-page="/Events/Details" asp-route-id="@ev.Id" class="btn-link-pill">Відкрити →</a>
                    </div>
                </article>
            }
        </div>
    }
</div>

<div class="grid-2">
    <div class="card">
        <h2>Створіть нову подію</h2>
        <p class="subtitle">
            Організатором стане поточний акаунт: <b>@userText</b>
        </p>
        <form method="post" asp-page-handler="CreateEvent">
            <div class="form-row">
                <div class="field">
                    <label>Назва події</label>
                    <input type="text" name="eventTitle" placeholder="Назва поїздки чи зустрічі" required />
                </div>
                <div class="field">
                    <label>Дата проведення</label>
                    <input type="date" name="eventDate" required />
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>Місце</label>
                    <input type="text" name="eventPlace" placeholder="Місто або локація" />
                </div>
                <div class="field">
                    <label>Ліміт бюджету (грн, необов'язково)</label>
                    <input type="text" name="budgetLimit" placeholder="Наприклад: 2500.00" />
                </div>
            </div>
            <div class="field">
                <label>Опис</label>
                <input type="text" name="eventDescription" placeholder="Короткий опис заходу" />
            </div>
            <button type="submit" class="btn-primary">Створити подію</button>
        </form>
        @if (!string.IsNullOrEmpty(Model.CreateEventMessage))
        {
            <div class="notice @(Model.CreateEventSuccess ? "ok" : "err")">@Model.CreateEventMessage</div>
        }
    </div>

    <div class="card">
        <h2>Приєднайтеся до події</h2>
        <p class="subtitle">
            Приєднається акаунт: <b>@userText</b>
        </p>
        <form method="post" asp-page-handler="JoinEvent">
            <div class="field">
                <label>Код запрошення</label>
                <input type="text" name="inviteCode" placeholder="Введіть 8-символьний код від організатора" required />
            </div>
            <div style="margin-top: 24px;">
                <button type="submit" class="btn-secondary">Приєднатися за кодом</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(Model.JoinEventMessage))
        {
            <div class="notice @(Model.JoinEventSuccess ? "ok" : "err")">@Model.JoinEventMessage</div>
        }
    </div>
</div>
